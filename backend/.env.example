SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Deployda: myapi.example.com,...

# Database settings
DB_NAME=dev_diva_quest
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Google AI API Key — skill test AI savollar (POST /api/skills/generate-session/) va baholash / CV
# Yangi kalit: https://aistudio.google.com/apikey  (muddati tugagan bo‘lsa check_gemini xato beradi)
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY_HERE
# Model: gemini-1.5-flash ba’zi kalitlar/API versiyalarida 404 beradi. Tavsiya:
GEMINI_MODEL=gemini-2.5-flash
# yoki: GEMINI_MODEL=gemini-2.0-flash

# Email settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@localhost

# SPA (Vite) manzili — tasdiq xati havolalari shu yerga ishora qiladi
FRONTEND_URL=http://127.0.0.1:8080

# CSRF (HTTPS deployda); bo‘sh bo‘lsa CORS ro‘yxati ishlatiladi
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# CORS — faqat ishlatadigan portlaringiz
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173,http://localhost:8080,http://localhost:5173

# Staff admin account (used by: python manage.py create_admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DevGirlzz@Admin2026
ADMIN_EMAIL=admin@devgirlzz.local

# Frontend (Vite) — copy to frontend/.env for local dev
# Dev: leave VITE_API_BASE_URL empty — requests go through Vite proxy /api → Django

VITE_API_BASE_URL=

# Production (devgirlzz.com.uz):
# VITE_API_BASE_URL=https://api.devgirlzz.com.uz/api/
# VITE_DJANGO_ORIGIN=https://api.devgirlzz.com.uz
# VITE_API_DIRECT=true
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8001

# Production / Docker build (nginx proxies /api to backend):
# VITE_API_BASE_URL=/api/

# Optional Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# VITE_DJANGO_ORIGIN=http://127.0.0.1:8000
